{
  "manifest_version": 3,
  "name": "Kolaysoft Köprüsü - İstiklal Muhasebe",
  "version": "1.0.0",
  "description": "Kolaysoft EczacıKart portalı açıkken gelen/giden/e-arşiv faturalarını OKUR ve İstiklal Muhasebe programına (Supabase) aktarır. Sadece okur: fatura kesmez, göndermez, hiçbir şeyi değiştirmez.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://portal.eczacikartfatura.com/*",
    "https://hmgxulrssqsqnfhibmzz.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://portal.eczacikartfatura.com/*"],
      "js": ["yakala.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://portal.eczacikartfatura.com/*"],
      "js": ["lib/supabase.min.js", "kopru.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
